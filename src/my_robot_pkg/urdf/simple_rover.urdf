<?xml version="1.0"?>

<robot name="simple_rover">

  <!-- Main body -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.0 0.6 0.2"/>
      </geometry>

      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Front-left wheel -->
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="front_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.35 0.34 -0.10" rpy="1.5708 0 0"/>
  </joint>

  <!-- Front-right wheel -->
  <link name="front_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="front_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.35 -0.34 -0.10" rpy="1.5708 0 0"/>
  </joint>

  <!-- Rear-left wheel -->
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="rear_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.35 0.34 -0.10" rpy="1.5708 0 0"/>
  </joint>

  <!-- Rear-right wheel -->
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="rear_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.35 -0.34 -0.10" rpy="1.5708 0 0"/>
  </joint>



  <!-- Arm base -->
  <link name="arm_base">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.08"/>
      </geometry>
      <material name="gray">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
  </joint>

  <!-- First arm link -->
  <link name="arm_link_1">
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.40"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.4 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="arm_base"/>
    <child link="arm_link_1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="1.0"/>
  </joint>

  <!-- Second arm link -->
  <link name="arm_link_2">
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.07 0.36"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.9 0.8 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="1.0"/>
  </joint>

  <!-- Camera at the end of the arm -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.14 0.10 0.08"/>
      </geometry>
      <material name="black_camera">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="arm_link_2"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
  </joint>

</robot>